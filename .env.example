# Web database (Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chinese generation model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Lightweight vector search
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Official YouTube discovery (Google Cloud YouTube Data API v3)
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# Discovery dry run
DISCOVERY_LIMIT=5

# Personal cost guardrail: successful DeepSeek knowledge extractions allowed per UTC day.
DAILY_PROCESS_LIMIT=1

# Production owner and email notification. These remain server-only secrets.
OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=http://localhost:3000
