{
  "name": "frontier-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "discover": "node --env-file-if-exists=.env.local --import tsx scripts/discover.ts",
    "automation:check": "node --import tsx scripts/check-automation-env.ts",
    "automate": "node --env-file-if-exists=.env.local --import tsx scripts/automate.ts",
    "process:first": "node --env-file-if-exists=.env.local --import tsx scripts/process-first-item.ts",
    "keepalive": "node --env-file-if-exists=.env.local --import tsx scripts/keepalive.ts",
    "rewrite:home-depot-visuals": "node --env-file-if-exists=.env.local --import tsx scripts/rewrite-home-depot-visuals.ts",
    "translate:evidence": "node --env-file-if-exists=.env.local --import tsx scripts/translate-evidence.ts",
    "cleanup:old-the-batch": "node --env-file-if-exists=.env.local --import tsx scripts/backup-and-remove-old-the-batch.ts",
    "sources:sync": "node --env-file-if-exists=.env.local --import tsx scripts/sync-source-registry.ts",
    "sources:audit": "node --env-file-if-exists=.env.local --import tsx scripts/audit-sources.ts",
    "capacity:audit": "node --env-file-if-exists=.env.local --import tsx scripts/audit-capacity.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
